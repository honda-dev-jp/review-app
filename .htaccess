# ----------------------------------------------------------------------
# portfolio.honda-dev.com 用 .htaccess
#
# honda-dev.com/public_html/.htaccess に共通防御がある本番環境でも、
# ローカル環境ではこのファイル単体で動作するため、
# portfolio 自身の安全性に必要なルールは重複して保持する。
#
# www.honda-dev.com → portfolio.honda-dev.com の正規化や、
# ドメイン全体のIP拒否などは親 .htaccess で管理する。
# ----------------------------------------------------------------------

RewriteEngine On

# 1. WordPress REST API 探索クエリを拒否
#    WordPressは使用していないため rest_route は不要
RewriteCond %{QUERY_STRING} (^|&)rest_route= [NC]
RewriteRule ^ - [R=404,L]

# 2. HTTPSへの転送
#    localhost（Docker等のローカル環境）はHTTPSリダイレクト対象外
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ----------------------------------------------------------------------
# クリックジャッキング対策
# ----------------------------------------------------------------------

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "frame-ancestors 'none'"
    Header always set X-Frame-Options "DENY"
</IfModule>

# ----------------------------------------------------------------------
# 共通セキュリティ対策
# ----------------------------------------------------------------------

# 3. WordPressを狙ったボットなどのアクセスを拒否
#    当サイトはWordPressを使用していないため全件拒否
<FilesMatch "^(wp-.*|xmlrpc\.php)">
    Order allow,deny
    Deny from all
</FilesMatch>

# 4. ディレクトリ一覧を無効化
Options -Indexes

# 5. .htaccess / .htpasswd / .env へのアクセスを禁止
<FilesMatch "^\.(ht|env)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 6. .envバリエーション全般を拒否
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

# 7. phpinfo系ファイルへのアクセスを拒否
<FilesMatch "^(phpinfo|info|php-info|debug)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 8. .gitディレクトリへのアクセスを拒否
#    ローカル環境では親 .htaccess が存在しないため、このルールを保持する
RedirectMatch 404 /\.git

# 9. /administrator/ 系パスを拒否
RedirectMatch 403 ^/administrator

# 10. .env系ファイルへのアクセスを全パスで拒否
RedirectMatch 403 /\.env($|/)

# ----------------------------------------------------------------------
# portfolio.honda-dev.com 固有の公開制御
# ----------------------------------------------------------------------

# 11. configディレクトリへの直接アクセスを拒否
#     対象：/config/database.php 等
RedirectMatch 403 ^/config(/|$)

# 12. 内部処理用ディレクトリへの直接アクセスを拒否
#     PHP内部の require_once には影響しない
RedirectMatch 403 ^/(?:app|includes|lib)(?:/|$)

# 13. 管理画面配下の内部処理用ファイル・ディレクトリを拒否
#     /admin/item_list.php 等の画面URL、/admin/css/、/admin/js/ は拒否しない
RedirectMatch 403 ^/admin/(?:bootstrap\.php|controller|guards|lang|lib|model|validator|view)(?:/|$)

# 14. 公開不要なドットファイル・ドットディレクトリを拒否
#     対象：/.gitignore / .gitattributes / .php-cs-fixer.cache / .vscode/ / .github/ 等
#     例外：/.well-known/ は証明書更新・外部検証用途で使われる可能性があるため許可
#     /.git/ は上の RedirectMatch 404 で処理するため除外
RedirectMatch 403 (^|/)\.(?!well-known(?:/|$)|git(?:/|$))[^/]+

# 15. 公開不要なドキュメント・開発用ディレクトリを拒否
#     対象：/docs/ / README.md / AGENTS.md
RedirectMatch 403 ^/docs(?:/|$)
RedirectMatch 403 ^/(?:README|AGENTS)\.md$

# 16. 依存関係・ビルド・整形ツール系の設定ファイルを拒否
RedirectMatch 403 ^/(?:composer\.(?:json|lock)|package(?:-lock)?\.json|yarn\.lock|pnpm-lock\.yaml)$

# 17. バックアップ・SQLダンプ・ログ・一時ファイルを拒否
#     対象例：*.bak / *.backup / *.old / *.orig / *.save / *.tmp / *.sql / *.log 等
RedirectMatch 403 (?i)(^|/).*\.(?:bak|backup|old|orig|save|swp|swo|tmp|temp|sql|sqlite|db|log)$
